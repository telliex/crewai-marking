# IMPORTANT: put comments on their OWN line. pydantic-settings does NOT strip
# inline "value  # comment" — the "# comment" becomes part of the value (this
# silently corrupts keys, the From address, and the compliance postal address).

# --- External services ---
# people search + email unlock (bulk_match spends credits)
APOLLO_API_KEY=
# sending
RESEND_API_KEY=
# CrewAI angle writer
ANTHROPIC_API_KEY=
# angle writer web research
SERPER_API_KEY=

# --- Database (Postgres in prod; SQLite works for local dev) ---
DATABASE_URL=postgresql+psycopg://outreach:outreach@localhost:5432/outreach

# --- Sender identity / compliance (a campaign may override any of these) ---
# use a SUBDOMAIN to protect main-domain reputation
OUTREACH_FROM=steven@mail.yourdomain.com
OUTREACH_FROM_NAME=Steven
# a monitored inbox
OUTREACH_REPLY_TO=steven@yourdomain.com
OUTREACH_SENDER_NAME=Steven Wu
OUTREACH_COMPANY=Awkns
# REQUIRED for real sends (legal); blank blocks sending
OUTREACH_POSTAL_ADDRESS=
OUTREACH_UNSUBSCRIBE_MAILTO=
# HMAC secret for unsubscribe tokens
OUTREACH_UNSUBSCRIBE_SECRET=change-me

# --- Web ---
# used to build unsubscribe links
APP_BASE_URL=http://localhost:8000
# HTTP-Basic password for the admin dashboard
ADMIN_PASSWORD=
# (follow-up) svix secret to verify Resend webhooks
RESEND_WEBHOOK_SECRET=
# Where user-uploaded footer/template images + attachments are stored. In prod
# the systemd units already set this to /var/lib/awkns-outreach/uploads (their
# StateDirectory, owned by the service user). Leave blank for local dev — it
# defaults to a folder inside the package. Only set this to override the path.
UPLOAD_DIR=

# --- Writer ---
CREW_MODEL=anthropic/claude-sonnet-4-5

# --- Sending limits / warmup ---
# All editable at runtime in Settings -> Variables ("Sending / Warmup"); these
# are just the seed defaults. Malformed values fall back to the built-in ones.
# Per-campaign 24h ceiling, and the warmup ramp (per-day caps from warmup_start).
WARMUP_DAILY_CAP=100
WARMUP_RAMP=5,10,15,20,25,30,40,50,60,70,80,90,100
# How a NEW campaign warms up: warm (start today) | full (already-warmed, full
# speed now) | none (leave unset -> 5/day).
WARMUP_DEFAULT_MODE=warm
# Local send window: hours [start-end) and weekdays (0=Mon .. 6=Sun).
SEND_HOURS=9-17
SEND_DAYS=0,1,2,3,4
# Spacing between real sends: min gap + random jitter (ms).
SEND_MIN_GAP_MS=90000
SEND_JITTER_MS=150000
# Errors before a lead's step is marked failed; stale "sending" claim recovery.
MAX_SEND_ERRORS=3
STALE_CLAIM_SECONDS=600
